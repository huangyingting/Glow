# Optional Open-Meteo customer key. Without it, Glow uses the rate-limited
# non-commercial open-access endpoint. With it, requests automatically use
# the licensed customer forecast and air-quality endpoints.
OPEN_METEO_API_KEY=

# Optional MapLibre style. The default is the keyless CARTO / OpenStreetMap raster style.
NEXT_PUBLIC_MAP_STYLE_URL=
